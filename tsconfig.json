{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "types": ["vite/client", "chrome", "node"],
    "paths": {
      "@reforma-digital/bridge": ["./packages/bridge/src/index.ts"],
      "@reforma-digital/capture": ["./packages/capture/src/index.ts"],
      "@reforma-digital/react": ["./packages/react/src/index.tsx"],
      "@reforma-digital/registry": ["./packages/registry/src/index.ts"],
      "@reforma-digital/runtime": ["./packages/runtime/src/index.tsx"],
      "@reforma-digital/site-dni": ["./sites/dni/src/index.ts"]
    }
  },
  "include": ["apps", "packages", "sites", "tests", "vitest.config.ts", "playwright.config.ts"],
  "exclude": ["apps/landing"]
}
